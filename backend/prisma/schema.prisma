// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int     @id @default(autoincrement())
  name          String
  email         String  @unique
  password_hash String
  role          Role
  manager_id    Int?
  project_id    Int?
  tasks         Tasks[]
}

enum Role {
  admin
  project_manager
  developer
}

enum ProjectRequestStatus {
  assigned
  converted
}

enum ProjectStatus {
  in_progress
  completed
}

enum TaskStatus {
  to_do
  in_progress
  completed
}

enum Priority {
  low
  high
  very_high
}

model ProjectRequests {
  // @db.* tells postgres the type of data to store in the table, ie , id would have type uuid in the database
  id             String               @id @default(uuid()) @db.Uuid
  title          String
  description    String
  assigned_pm_id Int
  status         ProjectRequestStatus @default(assigned)
  deadline       DateTime             @db.Date
  project        Project?
}

model Project {
  id                 Int             @id @default(autoincrement())
  project_request_id String          @unique @db.Uuid
  name               String
  description        String
  assigned_pm_id     Int
  status             ProjectStatus   @default(in_progress)
  projectRequest     ProjectRequests @relation(fields: [project_request_id], references: [id])
  tasks              Tasks[]
}

model Tasks {
  id                    String     @id @default(uuid()) @db.Uuid
  project_id            Int
  title                 String
  description           String
  assigned_developer_id Int
  status                TaskStatus @default(to_do)
  priority              Priority
  deadline              DateTime   @db.Date
  user                  User       @relation(fields: [assigned_developer_id], references: [id])
  project               Project    @relation(fields: [project_id], references: [id])
}
